{
  "name": "nhaccuahoiks",
  "version": "1.0.0",
  "private": true,
  "description": "NhacCuaHoiKS - He thong nghe nhac noi bo (internal music streaming) cho doanh nghiep",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:check": "tsx scripts/db-check.ts",
    "db:wipe-sample": "prisma db execute --file scripts/wipe-sample-data.sql",
    "admin:create": "tsx scripts/create-admin.ts",
    "metadata:check": "tsx scripts/metadata-check.ts",
    "db:setup": "prisma generate && prisma migrate deploy && npm run db:seed",
    "env:write": "node scripts/write-env.cjs",
    "app:name": "node scripts/set-app-name.cjs",
    "icons:pwa": "tsx scripts/generate-pwa-icons.ts",
    "smoke": "node scripts/smoke-test.cjs",
    "smoke:serve": "powershell -ExecutionPolicy Bypass -File scripts/smoke-serve.ps1",
    "bench": "node scripts/bench.cjs",
    "check:guest": "node scripts/guest-access-check.cjs",
    "check:guest:serve": "powershell -ExecutionPolicy Bypass -File scripts/guest-serve.ps1",
    "check:ui": "node scripts/ui-check.cjs",
    "check:ui:serve": "powershell -ExecutionPolicy Bypass -File scripts/ui-serve.ps1",
    "check:nav": "tsx scripts/verify-nav.ts",
    "check:autoplay": "tsx scripts/verify-autoplay.ts",
    "check:soundcloud": "tsx scripts/verify-soundcloud-engine.ts",
    "check:duration": "tsx scripts/verify-duration.ts",
    "check:dialogs": "tsx scripts/verify-dialogs.ts",
    "check:volume": "tsx scripts/verify-volume.ts",
    "check:seek": "tsx scripts/verify-seek.ts",
    "check:sleep": "tsx scripts/verify-sleep-timer.ts",
    "check:video": "tsx scripts/verify-video-stage.ts",
    "check:theme": "tsx scripts/verify-theme.ts",
    "check:history": "tsx scripts/verify-history.ts",
    "check:recent": "tsx scripts/verify-recent.ts",
    "check:mix": "tsx scripts/verify-mix.ts",
    "check:insights": "tsx scripts/verify-insights.ts",
    "check:shortcuts": "tsx scripts/verify-shortcuts.ts",
    "check:lyrics": "tsx scripts/verify-lyrics.ts",
    "check:thumbs": "tsx scripts/verify-thumbnails.ts",
    "check:resume": "tsx scripts/verify-resume.ts",
    "check:media": "tsx scripts/verify-media-session.ts",
    "check:search": "tsx scripts/verify-search.ts",
    "check:devices": "tsx scripts/verify-devices.ts",
    "check:deploy": "tsx scripts/verify-deploy.ts",
    "check:mobile": "tsx scripts/verify-mobile.ts",
    "check:youtube": "tsx scripts/verify-youtube-engine.ts",
    "check:playback": "tsx scripts/verify-playback-perf.ts",
    "verify": "powershell -ExecutionPolicy Bypass -File scripts/verify.ps1",
    "demo:audio": "powershell -ExecutionPolicy Bypass -File scripts/generate-demo-audio.ps1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^18.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
