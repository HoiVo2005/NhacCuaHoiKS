// =============================================================================
// NhacCuaHoiKS - Prisma schema cho PostgreSQL (Neon)
// =============================================================================
// GHI CHU THIET KE (giu nguyen tu ban SQL Server de khong phai sua tang ung dung):
//  - Khong dung `enum` cua Prisma => dung String + union type o tang TS.
//  - Khong dung `Json` => `tags` luu CSV, cac truong khac luu string.
//  - Khong dung scalar list (String[]) => dung bang trung gian.
//  - Native type: chuoi co gioi han dung @db.VarChar(n), noi dung dai dung @db.Text.
//  - Cac quan he tro ve User deu dung NoAction (an toan, khong xoa day chuyen ngoai y muon).
//  - SO SANH CHUOI: PostgreSQL PHAN BIET hoa/thuong (SQL Server thi khong), nen moi truy van
//    `contains` deu phai kem `mode: "insensitive"` (xem `src/services/song.service.ts`).
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Nguoi dung he thong: ADMIN (quan tri) va EMPLOYEE (nhan vien)
model User {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(255)
  name         String    @db.VarChar(200)
  passwordHash String    @db.VarChar(255)
  /// ADMIN | EMPLOYEE
  role         String    @default("EMPLOYEE") @db.VarChar(20)
  avatarUrl    String?   @db.VarChar(500)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdSongs  Song[]         @relation("SongCreatedBy")
  updatedSongs  Song[]         @relation("SongUpdatedBy")
  playlists     Playlist[]     @relation("PlaylistOwner")
  playlistItems PlaylistSong[] @relation("PlaylistItemAddedBy")
  favorites     Favorite[]
  history       ListenHistory[]
  devices       UserDevice[]

  @@index([role])
  @@index([isActive])
  @@map("users")
}

/// The loai nhac
model Genre {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.VarChar(500)
  /// Mau hien thi tren UI (dang hex, vi du #22d3ee)
  color       String?  @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  songs Song[]

  @@map("genres")
}

/// Bai nhac trong thu vien (YouTube / SoundCloud / TikTok / file upload)
model Song {
  id              String  @id @default(cuid())
  title           String  @db.VarChar(300)
  artist          String? @db.VarChar(200)
  album           String? @db.VarChar(200)
  description     String? @db.Text
  /// 0 = chua biet (se duoc cap nhat khi phat nhac)
  durationSeconds Int     @default(0)
  thumbnailUrl    String? @db.VarChar(1000)

  /// YOUTUBE | SOUNDCLOUD | TIKTOK | UPLOADED
  sourceType String  @db.VarChar(20)
  /// ID tren nen tang goc (videoId / trackId / postId)
  sourceId   String? @db.VarChar(200)
  /// URL goc do quan tri vien dan vao
  sourceUrl  String? @db.VarChar(1000)
  /// URL phat truc tiep (chi voi bai UPLOADED)
  streamUrl  String? @db.VarChar(1000)
  /// URL nhung iframe chinh thuc (YouTube/SoundCloud/TikTok)
  embedUrl   String? @db.VarChar(1000)
  /// EMBED | DIRECT
  playbackType String @default("EMBED") @db.VarChar(20)

  /// Thong tin file (chi voi bai UPLOADED)
  mimeType      String? @db.VarChar(100)
  fileSizeBytes Int?
  /// Duong dan tuong doi trong storage (chi voi bai UPLOADED)
  storageKey String? @db.VarChar(500)

  /// Danh sach tag phan cach bang dau phay
  tags String? @db.VarChar(500)

  genreId String?
  genre   Genre?  @relation(fields: [genreId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  isPublished Boolean @default(true)
  playCount   Int     @default(0)

  createdById String?
  createdBy   User?   @relation("SongCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedById String?
  updatedBy   User?   @relation("SongUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playlistItems PlaylistSong[]
  favorites     Favorite[]
  history       ListenHistory[]
  lyrics        SongLyrics?

  @@index([sourceType])
  @@index([genreId])
  @@index([isPublished])
  @@index([createdAt])
  @@index([title])
  @@index([playCount])
  @@map("songs")
}

/// Loi bai hat (LRCLIB hoac do quan tri vien dan vao) - luu lai de khong goi mang moi lan mo bai
model SongLyrics {
  id      String @id @default(cuid())
  songId  String @unique
  song    Song   @relation(fields: [songId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  /// LRC co moc thoi gian (karaoke) - null khi chi co loi thuong hoac khong tim thay
  syncedLyrics String? @db.Text
  /// Loi thuong (khong moc thoi gian)
  plainLyrics  String? @db.Text

  /// LRCLIB | MANUAL
  source String @db.VarChar(20)
  /// Ten bai/nghe si da dung de tra cuu (de biet cache ung voi tu khoa nao)
  matchedTrack  String? @db.VarChar(300)
  matchedArtist String? @db.VarChar(200)
  /// Nguoi dan loi tay (quan tri vien)
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("song_lyrics")
}

/// Danh sach phat (cua ca nhan hoac do quan tri vien tao cho toan cong ty)
model Playlist {
  id          String  @id @default(cuid())
  name        String  @db.VarChar(200)
  description String? @db.VarChar(1000)
  coverUrl    String? @db.VarChar(1000)
  /// true = moi nguoi deu xem duoc (playlist chinh thuc)
  isPublic    Boolean @default(false)
  /// true = do quan tri vien tao (playlist noi bo cong ty)
  isFeatured  Boolean @default(false)

  ownerId String
  owner   User   @relation("PlaylistOwner", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PlaylistSong[]

  @@index([ownerId])
  @@index([isFeatured])
  @@map("playlists")
}

/// Bang trung gian Playlist - Song (co thu tu phat)
model PlaylistSong {
  id         String   @id @default(cuid())
  playlistId String
  songId     String
  position   Int      @default(0)
  addedById  String?
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  addedBy  User?    @relation("PlaylistItemAddedBy", fields: [addedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([playlistId, songId])
  @@index([playlistId, position])
  @@index([songId])
  @@map("playlist_songs")
}

/// Bai nhac yeu thich cua tung nguoi dung
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  songId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, songId])
  @@index([userId, createdAt])
  @@map("favorites")
}

/// Lich su nghe nhac
model ListenHistory {
  id        String   @id @default(cuid())
  userId    String
  songId    String
  playedAt  DateTime @default(now())
  /// So mili-giay da nghe
  msPlayed  Int      @default(0)
  completed Boolean  @default(false)
  /// Nguon phat sinh: web | player | api
  source    String?  @db.VarChar(50)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, playedAt])
  @@index([songId])
  @@index([playedAt])
  @@map("listen_history")
}

/// Cau hinh he thong do quan tri vien thay doi (key/value)
model AppSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.VarChar(1000)
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

/// Thiet bi / phien dang nhap cua nguoi dung.
///
/// Dung cho tinh nang "Quan ly thiet bi dang dang nhap":
///  - Hien IP, ten may (suy ra tu User-Agent), vi tri (suy tu IP) va lan dung gan nhat.
///  - Dang xuat TU XA tung thiet bi (`revokedAt`) hoac tat ca thiet bi.
///  - CHAN dang nhap tu mot thiet bi (`blockedAt`): chi khi duoc "mo chan" thiet bi do
///    moi dang nhap lai duoc -> dung khi mat dien thoai / may la.
model UserDevice {
  id     String @id @default(cuid())
  userId String

  /// Dau vet thiet bi: sha256(cookie thiet bi + User-Agent) - on dinh qua nhieu lan dang nhap
  deviceKey String @db.VarChar(64)

  /// Ten do nguoi dung tu dat (neu co) - uu tien hien thi thay cho ten tu dong
  label String? @db.VarChar(100)

  /// Ten tu dong nhan dien tu User-Agent (vi du "Chrome tren Windows")
  deviceName String  @db.VarChar(120)
  browser    String? @db.VarChar(60)
  platform   String? @db.VarChar(60)
  userAgent  String? @db.VarChar(500)

  ipAddress String? @db.VarChar(60)
  /// Dia diem suy ra tu IP (vi du "Ha Noi, Viet Nam")
  location          String?   @db.VarChar(160)
  /// Lan cuoi goi API tra cuu vi tri (tranh goi lai lien tuc khi IP khong doi)
  locationUpdatedAt DateTime?

  firstLoginAt DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  /// Bi dang xuat tu xa: phien hien tai het hieu luc, thiet bi phai dang nhap lai
  revokedAt      DateTime?
  revokedByEmail String?   @db.VarChar(255)

  /// Bi CHAN dang nhap: khong the dang nhap lai cho toi khi duoc mo chan
  blockedAt      DateTime?
  blockedByEmail String?   @db.VarChar(255)
  blockedReason  String?   @db.VarChar(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, deviceKey])
  @@index([userId, lastSeenAt])
  @@index([blockedAt])
  @@map("user_devices")
}
