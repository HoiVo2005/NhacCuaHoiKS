# =============================================================================
# MyMusic - Bien moi truong (KHONG commit file nay len git)
# Copy sang .env va chinh sua theo moi truong cua ban.
# =============================================================================

# --- Database: PostgreSQL (Neon / Render Postgres) ---
# Lay o Neon: Project -> Connection string -> chon "Pooled connection" (co chu "-pooler").
# Bat buoc co ?sslmode=require (Neon khong cho ket noi khong SSL).
# KHONG dat mat khau that vao file nay (repo la cong khai) - dien gia tri cua ban vao .env:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js (NextAuth v5) ---
# Sinh chuoi ngau nhien: npm run env:write (hoac npx auth secret)
AUTH_SECRET="ThayBangChuoiNgauNhienToiThieu32KyTu0000000000"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Bat buoc la "true" neu chay qua HTTPS (cookie __Secure-). De trong de tu dong theo AUTH_URL.
AUTH_USE_SECURE_COOKIES=""

# --- Storage cho file upload ---
# local | s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".data/uploads"
STORAGE_PUBLIC_PREFIX="/api/files"
UPLOAD_MAX_BYTES="52428800"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# --- Metadata adapters (tuy chon) ---
# Neu co YOUTUBE_API_KEY thi lay duoc ca thoi luong video tu YouTube Data API v3
YOUTUBE_API_KEY=""
# Neu co SOUNDCLOUD_CLIENT_ID (dang ky mien phi tai developers.soundcloud.com)
# thi lay duoc day du thong tin + thoi luong SoundCloud ngay tren server
SOUNDCLOUD_CLIENT_ID=""
METADATA_TIMEOUT_MS="8000"

# --- Ung dung ---
NEXT_PUBLIC_APP_NAME="NhacCuaHoiKS"

# --- Docker compose (tuy chon) ---
# Chi can khi bo comment service `postgres` trong docker-compose.yml (PostgreSQL chay ngay tren may).
POSTGRES_USER=""
POSTGRES_PASSWORD=""
