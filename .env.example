# =============================================================================
# MyMusic - Bien moi truong (KHONG commit file nay len git)
# Copy sang .env va chinh sua theo moi truong cua ban.
# =============================================================================

# --- Database: Microsoft SQL Server (Prisma) ---
# Dinh dang: sqlserver://HOST:PORT;database=DB;schema=dbo;user=USER;password=PASS;encrypt=true;trustServerCertificate=true
# KHONG dat mat khau that vao file nay (repo la cong khai) - dien gia tri cua MAY BAN vao .env:
DATABASE_URL="sqlserver://localhost:1433;database=NhacCuaHoi;schema=dbo;user=YOUR_SQL_USER;password=YOUR_SQL_PASSWORD;encrypt=true;trustServerCertificate=true;connectTimeout=15"

# --- Auth.js (NextAuth v5) ---
# Sinh chuoi ngau nhien: npm run env:write (hoac npx auth secret)
AUTH_SECRET="ThayBangChuoiNgauNhienToiThieu32KyTu0000000000"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Bat buoc la "true" neu chay qua HTTPS (cookie __Secure-). De trong de tu dong theo AUTH_URL.
AUTH_USE_SECURE_COOKIES=""

# --- Storage cho file upload ---
# local | s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".data/uploads"
STORAGE_PUBLIC_PREFIX="/api/files"
UPLOAD_MAX_BYTES="52428800"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# --- Metadata adapters (tuy chon) ---
# Neu co YOUTUBE_API_KEY thi lay duoc ca thoi luong video tu YouTube Data API v3
YOUTUBE_API_KEY=""
# Neu co SOUNDCLOUD_CLIENT_ID (dang ky mien phi tai developers.soundcloud.com)
# thi lay duoc day du thong tin + thoi luong SoundCloud ngay tren server
SOUNDCLOUD_CLIENT_ID=""
METADATA_TIMEOUT_MS="8000"

# --- Ung dung ---
NEXT_PUBLIC_APP_NAME="NhacCuaHoiKS"

# --- Docker compose (tuy chon) ---
# BAT BUOC khi chay `docker compose up`: mat khau SA cua SQL Server trong container.
# De trong thi docker compose se bao loi va dung lai (khong dung mat khau mac dinh).
MSSQL_SA_PASSWORD=""
